FROM node:24-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN node node_modules/vite/bin/vite.js build --config vite.process.config.ts

FROM node:24-alpine
WORKDIR /app
COPY --from=builder /app/dist/process-studio ./public
COPY process-studio-server.mjs ./
ENV NODE_ENV=production
EXPOSE 3082
CMD ["node", "process-studio-server.mjs"]
