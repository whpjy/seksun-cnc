CNC_STORAGE_ROOT=.seksun-cnc/jobs
CNC_ANALYZER_BIN=occt-analyzer
CNC_FREECAD_CMD=FreeCADCmd
CNC_MAX_UPLOAD_MB=200
CNC_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
CNC_PUBLIC_BASE_URL=http://192.168.1.100:3001
CNC_HARNESS_ONLY=true
VITE_API_BASE=
VITE_DEV_API_TARGET=http://127.0.0.1:8090
VITE_HARNESS_URL=http://127.0.0.1:3080
VITE_APP_NAME=NEXUS CNC
VITE_PAGE_TITLE=智能工艺规划
VITE_APP_LOGO_TEXT=N

# Alibaba Cloud Model Studio (China/Beijing pay-as-you-go endpoint).
# Keep the real key only in .env; never commit it.
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Pin the snapshot in production so planning results remain reproducible.
QWEN_MODEL=qwen3.8-flash
QWEN_TIMEOUT_SECONDS=120
# Keep synchronous reviews responsive; use a future async/streaming route for deep thinking.
QWEN_PLANNING_THINKING=false

# LangGraph CNC agent orchestration. Shadow mode never replaces production results.
CNC_AGENT_MODE=active
CNC_AGENT_CHECKPOINTER=sqlite
CNC_AGENT_CHECKPOINT_PATH=.seksun-cnc/langgraph.sqlite
CNC_AGENT_MAX_LOCAL_RETRIES=3
CNC_AGENT_MAX_SETUP_REPLANS=1
CNC_AGENT_MAX_GLOBAL_REPLANS=1
CNC_AGENT_HUMAN_REVIEW_ENABLED=true
